# 默认逐字节保留主题与插件文件，避免无关换行改写。
* -text

# 只规范仓库自有说明和控制文件。
/*.md text eol=lf
/plugins/**/README.md text eol=lf
/**/VERSION text eol=lf
/.gitignore text eol=lf
/.gitattributes text eol=lf

# 主题配置解析对换行敏感，保留下载时的原始 CRLF。
**/theme.config -text

# 常见二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary
*.mp4 binary
